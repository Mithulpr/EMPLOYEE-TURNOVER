      "learning_rate": 0.08,
      "num_leaves": 31,
      "max_depth": 6,
      "subsample": 0.8,
      "n_estimators": 100
    },
    "evaluation_protocol": "10-Fold Stratified Cross-Validation on all 2,969 samples"
